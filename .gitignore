# Generated by Cargo: build artifacts and executables.
/target/
debug/

# Cargo.lock is committed on purpose: this workspace produces an executable
# (narvo-app), so the exact dependency set has to be reproducible.
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# Backup files written by rustfmt.
**/*.rs.bk

# Debug information generated by MSVC builds of rustc.
*.pdb

# Local, machine-specific cargo overrides. The checked-in .cargo/config.toml
# stays authoritative; personal tweaks belong next to it and stay untracked.
.cargo/config.local.toml
